# ─────────────────────────────────────────────────────────────────────────────
# Somba&Teka — docker compose environment.  cp .env.example .env  and fill in.
# Generate each secret with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

JWT_SECRET=
JWT_REFRESH_SECRET=
DATA_ENCRYPTION_KEY=            # exactly 64 hex chars — LOSING THIS LOSES ALL ENCRYPTED USER DATA; back it up

DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional — Firebase Cloud Messaging push (raw service-account JSON or its base64).
# Leave empty to run without push; in-app realtime delivery is unaffected.
FIREBASE_SERVICE_ACCOUNT_JSON=
