# Somba&Teka web — environment template. Copy to `.env.local`.
# Base URL of the NestJS API (REST auth). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Socket.IO endpoint (usually same origin as the API).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Existing prototype market toggle (france | drc)
NEXT_PUBLIC_MARKET_PROFILE=france

# Google Maps address picker (customer addresses). Browser key restricted to your site's HTTP referrers.
# Enable in Google Cloud: Maps JavaScript API, Places API (New), Geocoding API (billing must be on).
# Leave empty to disable the map: the address form then works with manual entry only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management). Defaults to Google's DEMO_MAP_ID for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Web push for the seller, admin and warehouse portals (Firebase → Project settings → Your apps → Web app, and
# Cloud Messaging → Web Push certificates for the VAPID key). Leave empty to keep push off: the portals still show
# desktop alerts while a tab is open. See docs/MOBILE-PUSH.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
