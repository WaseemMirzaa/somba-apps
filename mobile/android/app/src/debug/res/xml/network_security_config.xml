<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to any host, so the app can reach a local API (10.0.2.2, a LAN IP). Release builds use
     src/main/res/xml/network_security_config.xml, which allows cleartext to the test server's IP only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
