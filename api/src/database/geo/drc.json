  "meta": {
    "title": "DRC geographic hierarchy: provinces, villes, Kinshasa districts and communes",
    "compiledOn": "2026-10-26",
    "readme": "docs/DRC-GEOGRAPHY.md",
    "codePolicy": "Province codes are official ISO 3166-2:CD codes. All city, district and commune codes are INTERNAL codes proposed for this project (pattern CD-<province ISO suffix>-<3 letters>; districts CD-KN-D-<3 letters>). No official national code system for villes or communes was found. They are not ISO, INS or government codes.",
    "cityStatus": {
      "official": "Listed among the 33 villes of the CENI 2023 seat-distribution list, or Kinshasa (ville-province).",
      "decree-2013": "Ville status conferred by the decrees of 13 June 2013 but absent from the CENI 2023 list; present in the owner list; current operational status not verified."
    },
    "inOwnerList": "true when the city is in the owner-supplied list of 33; false when it was ADDED because official sources list it (see docs/DRC-GEOGRAPHY.md section 4).",
    "isCapital": "true when the city is the chef-lieu (provincial capital) of its province under Loi organique 15/006 of 25 March 2015. Kinshasa is also the national capital.",
    "coordinates": "Decimal degrees WGS84, 4 decimals. Accuracy about 1-3 km (several sources round to the arc-minute). Commune points are OSM boundary centres, except Gombe, Mont-Ngafula, Maluku and Nsele where a point in the built-up area (Wikipedia) is used. See docs/DRC-GEOGRAPHY.md section 5.",
    "communeStats": "areaKm2 from INS via FR Wikipedia (cross-checked with EN Wikipedia). population is the INS estimate for 1 July 2004 (populationYear) and is badly outdated for Kinshasa; use only for relative weights.",
    "quartiers": "Empty for all 24 communes on purpose: no reliable, complete, consistent source was found. See docs/DRC-GEOGRAPHY.md section 6.",
    "licences": "Includes data derived from OpenStreetMap (c) OpenStreetMap contributors, ODbL 1.0, and Wikipedia (CC BY-SA 4.0). Keep attribution if redistributed."
  },
