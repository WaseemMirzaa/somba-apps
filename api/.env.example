# NODE_ENV=production enables the fail-fast secret/DB guard (see assert-production.ts)
# NODE_ENV=development
# ─────────────────────────────────────────────────────────────
# Somba&Teka API — environment template
# Copy to `.env` and fill real secrets. `.env` is gitignored.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# HTTP + realtime port
PORT=3001

# Comma-separated list of allowed web/app origins (CORS + socket handshake)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-hex-32
JWT_REFRESH_TTL=30d

# ── Field encryption (AES-256-GCM) ────────────────────────────
# MUST be 64 hex chars (= 32 bytes). Encrypts email/phone/address at rest.
DATA_ENCRYPTION_KEY=replace-with-64-hex-chars

# ── Database ──────────────────────────────────────────────────
# DB_TYPE = sqlite (local, zero-setup) | mysql (production, per CONFIG.md)
DB_TYPE=sqlite
DB_SQLITE_FILE=somba.dev.sqlite
# Dev auto-creates the schema. In production leave this false and use migrations
# (npm run migration:generate / migration:run). The prod guard refuses boot if true.
DB_SYNCHRONIZE=true

# MySQL settings (used only when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=somba

# Apply pending migrations on boot (defaults to true in production)
# DB_MIGRATIONS_RUN=true

# --- Mobile money (Airtel / Orange / M-Pesa) ---
# none = refuse mobile money (default, fails closed) | sandbox = simulated (refused when NODE_ENV=production)
MM_PROVIDER=none
# HMAC secret the aggregator signs webhooks with (POST /api/v1/payments/webhook/mobile-money)
MM_WEBHOOK_SECRET=
# Minutes before an unpaid mobile-money intent expires
MM_PENDING_TTL_MIN=15
# Hours a delivered sale must age before it is payable (default 48 in production, 0 in dev)
PAYOUT_CLEARANCE_HOURS=48

# Optional: share realtime rooms between several API instances (redis://host:6379)
# REDIS_URL=

# ── Machine translation (EN <-> FR, docs/MULTILINGUAL-PLAN.md) ──
# google | fake | off.  Default: google when a credential below exists, else off (nothing is translated, the apps show the
# text as written). `fake` writes "[fr] text" / "[en] text": tests and smokes only.
# TRANSLATE_PROVIDER=
# Cloud Translation credential, any ONE of: a SERVER-ONLY key restricted to the Cloud Translation API (never reuse the
# app / web keys), or the Firebase service account above (give it the role "Cloud Translation API User").
# GOOGLE_TRANSLATE_API_KEY=
# Characters sent to Google per day (UTC); over it, jobs wait for the next day. 300000 is about $6 at $20 per million.
# TRANSLATE_DAILY_CHAR_LIMIT=300000
# Retry sweep of queued translations, in ms (0 = off).
# TRANSLATE_SWEEP_MS=60000

# ── Seller platform (docs/contracts/seller-platform.md) ──
# Where store KYC documents live. MUST be outside the public uploads folder and persisted / backed up with it.
# PRIVATE_UPLOAD_DIR=/opt/somba/uploads-private
# Store reputation (rating, fulfilment rate, badge) is recomputed on this interval, in ms (0 = off).
# SELLER_SCORE_SWEEP_MS=3600000
# A store on vacation reopens by itself when its return date passes; checked on this interval, in ms (0 = off).
# VACATION_SWEEP_MS=300000
# Base URL of the web app, used in team invitation e-mails.
# WEB_URL=https://somba.app
